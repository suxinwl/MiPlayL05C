GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=58092
OO_MUSIC_BASE_URL=http://oo-music:8787

# The voice interface hides the platform choice. Set one active backend source
# here and restart the gateway when switching between QQ and NetEase.
MUSIC_SOURCE=qq
MUSIC_QUALITY=320mp3
MUSIC_ALLOW_FALLBACK=true

# Optional only when oo-music public API authorization is enabled. Keep both
# values blank when the services are restricted to the private Docker network.
OO_MUSIC_CLIENT_ACCOUNT_ID=
OO_MUSIC_CLIENT_ACCESS_KEY=

# Xiaomi account/device values are intentionally blank in this template.
MI_USER=
MI_PASS=
MI_DID=
MI_TOKEN_PATH=/config/.mi.token
SPEAKER_HARDWARE=L05C
SPEAKER_TTS_COMMAND=5,3
STREAM_RESPONSE=false
MI_LISTENER_ENABLED=false
MI_POLL_INTERVAL=1.0

# Select one active provider for the first deployment.
MODEL_PROVIDER=deepseek
MODEL_NAME=deepseek-flash
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=
