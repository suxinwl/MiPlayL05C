# Copy this file to .env in the same iKuai Compose project directory.
# Do not upload the completed .env to GitHub.

OO_MUSIC_ADMIN_USERNAME=admin
OO_MUSIC_ADMIN_PASSWORD=替换为强密码

# Valid values: qq or netease. Change and recreate xiaomi-gateway to switch.
MUSIC_SOURCE=qq
MUSIC_QUALITY=320mp3
MUSIC_ALLOW_FALLBACK=true

# Leave blank unless oo-music public API authorization is enabled.
OO_MUSIC_CLIENT_ACCOUNT_ID=
OO_MUSIC_CLIENT_ACCESS_KEY=

# Xiaomi/MiService. Keep listener disabled for the first checks.
MI_USER=
MI_PASS=
MI_DID=
MI_LISTENER_ENABLED=false
MI_POLL_INTERVAL=1.0

# OpenAI-compatible provider.
MODEL_PROVIDER=deepseek
MODEL_NAME=deepseek-chat
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ARK_API_KEY=
