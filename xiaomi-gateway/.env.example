GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=58092

# Music backend: lxserver native API. Sources: kw/kg/tx/wy/mg.
MUSIC_BACKEND=lxserver
LXSERVER_BASE_URL=http://lxserver:9527
LXSERVER_USER_NAME=open
LXSERVER_USER_TOKEN=
MUSIC_SOURCE=kw
MUSIC_QUALITY=320mp3
MUSIC_ALLOW_FALLBACK=true

# Legacy oo-music compatibility is retained in code but is not used by the
# current deployment.
OO_MUSIC_BASE_URL=http://oo-music:8787
OO_MUSIC_CLIENT_ACCOUNT_ID=
OO_MUSIC_CLIENT_ACCESS_KEY=

# Xiaomi/MiService (fill only in the protected deployment environment)
# MI_USER=your-xiaomi-id
# MI_PASS=your-xiaomi-password
# MI_DID=your-speaker-did-or-name
# MI_MIOT_DID=your-miot-did
# MI_TOKEN_PATH=/config/mi.token
# SPEAKER_HARDWARE=L05C
# SPEAKER_TTS_COMMAND=5,3
# STREAM_RESPONSE=false
# MI_LISTENER_ENABLED=false
# MI_POLL_INTERVAL=1.0

# Select one active model profile; do not commit any key here.
MODEL_PROVIDER=doubao
MODEL_NAME=your-ark-endpoint-id
MODEL_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# MODEL_API_KEY=填入部署环境，不要提交到仓库
# OPENAI_API_KEY=填入部署环境
# ARK_API_KEY=填入部署环境
# XIAOZHI_API_KEY=仅在 OpenAI 兼容的小智适配层上使用

# DeepSeek/GPT/Doubao and an optional xiaozhi OpenAI-compatible adapter use
# the same chat client. xiaozhi-esp32-server itself is WebSocket/MQTT based;
# it is not a direct HTTP chat endpoint.
