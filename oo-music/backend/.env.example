# Runtime configuration. Copy this file to .env and adjust the values.
# QQ Music and NetEase Cloud Music accounts are stored in SQLite and managed
# from the admin web UI. Do not put platform credentials in environment variables.

# Optional backend listen address.
# OO_MUSIC_ADDR=127.0.0.1:8787

# Optional SQLite database path. Defaults to ./data/oo-music.db.
# OO_MUSIC_DB_PATH=./data/oo-music.db

# Optional directory containing the built React admin web files. When set, the
# same HTTP server exposes both the admin UI and the API. The container image
# sets this to /app/web automatically.
# OO_MUSIC_WEB_DIST=../admin-web/dist

# Initial backend administrator. The account is created only when admin_users
# is completely empty. Changing these values later does not overwrite an
# existing administrator table; manage additional accounts from the admin UI.
OO_MUSIC_ADMIN_USERNAME=admin
OO_MUSIC_ADMIN_PASSWORD=请替换为至少8位强密码
# OO_MUSIC_ADMIN_SESSION_TTL=12h
# OO_MUSIC_ADMIN_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Automatic membership replenishment keeps at most one active QQ Music VIP account
# and one active NetEase Cloud Music VIP account. When a platform has no active
# member account, the backend fetches the latest public invitation list from
# https://h.m4a.cn/ and claims through that platform's official API.
# The optional entries below are only additional fallback links.
# OO_MUSIC_EXPERIENCE_CARD_URLS=https://y.qq.com/...cardid=...

# Daily account login-state self-check. Defaults are 11:00 and Asia/Shanghai.
# OO_MUSIC_LOGIN_CHECK_TIME=11:00
# OO_MUSIC_LOGIN_CHECK_TIMEZONE=Asia/Shanghai

# Optional SMTP notification. Set all sender settings below to enable email.
# QQ Mail commonly uses port 465 with implicit TLS, or port 587 with STARTTLS.
# OO_MUSIC_SMTP_HOST=smtp.qq.com
# OO_MUSIC_SMTP_PORT=465
# OO_MUSIC_SMTP_TLS_MODE=implicit
# OO_MUSIC_SMTP_USERNAME=your-account@qq.com
# OO_MUSIC_SMTP_PASSWORD=your-smtp-authorization-code
# OO_MUSIC_MAIL_FROM=your-account@qq.com
# OO_MUSIC_MAIL_TO=209192670@qq.com
